# Configuração do app. Copie este arquivo para mobile/.env (o .env não entra no git).
# Estes valores entram no pacote do app: nenhum deles é segredo.
#
# Endereço da API.
#   Emulador Android: http://10.0.2.2:8080   Simulador iOS: http://localhost:8080
#   Aparelho real: http://<IP da sua máquina na rede local>:8080
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Endereço da web pública. O link da carteirinha usa este endereço.
#   Local: o endereço do npm run web no navegador da sua máquina.
EXPO_PUBLIC_WEB_URL=http://localhost:8081

# Firebase. Com o emulador do Authentication, o projeto é demo-nupii e a chave pode ser qualquer texto.
# O valor abaixo só serve para o emulador. Para o projeto real, execute ./deploy/firebase-setup.sh.
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-nupii
EXPO_PUBLIC_FIREBASE_API_KEY=local-emulator

# Endereço do emulador do Authentication. Deixe vazio para usar o projeto real.
#   Emulador Android: http://10.0.2.2:9099   Simulador iOS: http://localhost:9099
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://10.0.2.2:9099
