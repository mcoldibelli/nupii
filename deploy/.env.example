# Configuração do ambiente local (docker compose).
#
# 1. Copie este arquivo para deploy/.env. O arquivo .env não entra no git.
# 2. Preencha os valores vazios. Para gerar um valor: openssl rand -hex 24
#    Use só letras e números na senha do banco: o valor entra em uma URL.
#
# Nenhum valor secreto fica neste arquivo.

# Postgres
POSTGRES_USER=nupii
POSTGRES_DB=nupii
POSTGRES_PASSWORD=

# Servidor S3 (SeaweedFS)
S3_BUCKET=nupii-local
S3_ACCESS_KEY_ID=nupii-local
S3_SECRET_ACCESS_KEY=
# Endereço do servidor S3 visto pelo app. Ele vai nas URLs temporárias das fotos.
# Emulador Android: http://10.0.2.2:8333   Navegador e simulador iOS: http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
