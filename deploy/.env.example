# Configuração do ambiente local (docker compose).
#
# 1. Copie este arquivo para deploy/.env. O arquivo .env não entra no git.
# 2. Preencha os valores vazios. Para gerar um valor: openssl rand -hex 24
#
# Nenhum valor secreto fica neste arquivo.

# Postgres
POSTGRES_USER=nupii
POSTGRES_DB=nupii
POSTGRES_PASSWORD=

# Servidor S3 (SeaweedFS)
S3_BUCKET=nupii-local
S3_ACCESS_KEY_ID=nupii-local
S3_SECRET_ACCESS_KEY=
